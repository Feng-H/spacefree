{
  "name": "macos-dynamic-space-free",
  "version": "0.2.4",
  "description": "macOS 动态磁盘清理工具：基于程序/包的真实使用频率智能清理 Homebrew 包、应用、安装包与缓存（终端核心 + Web 仪表盘）",
  "type": "module",
  "bin": {
    "spacefree": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "macos",
    "cleanup",
    "homebrew",
    "disk",
    "usage-tracking",
    "space"
  ]
}
